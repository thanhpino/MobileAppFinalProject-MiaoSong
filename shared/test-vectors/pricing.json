        "toppingOptionIds": ["opt_top_cha", "opt_top_gio"],
        "note": "Không hành"
      },
      "lineB": {
        "menuItemId": "item_bun_rieu",
        "sizeOptionId": "opt_size_large",
        "toppingOptionIds": ["opt_top_gio", "opt_top_cha"],
        "note": "nhiều hành"
      },
      "expectedRawA": "item_bun_rieu|opt_size_large|opt_top_cha,opt_top_gio|không hành",
      "expectedRawB": "item_bun_rieu|opt_size_large|opt_top_cha,opt_top_gio|nhiều hành",
      "expectEqual": false
    },
    {
      "id": "CLK-02",
      "description": "Thứ tự chọn topping khác nhau và khoảng trắng/chữ hoa trong ghi chú khác nhau nhưng cùng nội dung phải gộp thành 1 dòng",
      "lineA": {
        "menuItemId": "item_bun_rieu",
        "sizeOptionId": "opt_size_regular",
        "toppingOptionIds": ["opt_top_gio", "opt_top_cha"],
        "note": "  KHÔNG   hành  "
      },
      "lineB": {
        "menuItemId": "item_bun_rieu",
        "sizeOptionId": "opt_size_regular",
        "toppingOptionIds": ["opt_top_cha", "opt_top_gio"],
        "note": "không hành"
      },
      "expectedRawA": "item_bun_rieu|opt_size_regular|opt_top_cha,opt_top_gio|không hành",
      "expectedRawB": "item_bun_rieu|opt_size_regular|opt_top_cha,opt_top_gio|không hành",
      "expectEqual": true
    }
