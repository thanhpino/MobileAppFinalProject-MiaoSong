@startuml MiaoSong_KhachHang
title Phân hệ 1: Trải nghiệm Khách hàng & Đặt món (Customer Experience)
left to right direction

skinparam defaultFontName "Arial"
skinparam defaultFontSize 12
skinparam roundcorner 10
skinparam shadowing false
skinparam packageStyle rectangle

skinparam actor {
    BorderColor #8A57E8
    BackgroundColor #F3EDF7
    FontColor #212121
    FontSize 12
}

skinparam usecase {
    BorderColor #E65100
    BackgroundColor #FFF8E1
    FontColor #212121
    FontSize 12
    ArrowColor #37474F
}

skinparam rectangle {
    BorderColor #9E9E9E
    BackgroundColor #FAFAFA
    FontColor #212121
    FontSize 13
}

skinparam package {
    BorderColor #BDBDBD
    BackgroundColor #F5F5F5
    FontColor #37474F
    FontSize 12
}

skinparam arrow {
    Color #37474F
    FontColor #455A64
    FontSize 11
}


actor "Khách hàng\n(CUSTOMER)" as KH

actor "OpenStreetMap\n(OSM / Nominatim)" as OSM <<System>>
actor "Lalamove API\n<<Giao vận>>" as LL <<System>>
actor "ZaloPay Sandbox\n<<Thanh toán>>" as ZLP <<System>>
actor "FCM\n<<Push Notification>>" as FCM <<System>>

rectangle "Phân hệ Khách hàng (Customer Experience)" {
    usecase "UC01: Đăng nhập / Đăng ký" as UC01
    usecase "UC02: Quản lý địa chỉ nhận hàng" as UC02
    usecase "UC04: Xem thực đơn theo nhóm" as UC04
    usecase "UC05: Tùy chỉnh món (Size / Topping)" as UC05
    usecase "UC06: Quản lý giỏ hàng" as UC06
    usecase "UC07: Áp dụng voucher" as UC07
    usecase "UC08: Xem báo giá ship theo km" as UC08
    usecase "UC09: Đặt hàng & Thanh toán (COD / ZaloPay)" as UC09
    usecase "UC10: Theo dõi đơn & Thẻ tài xế" as UC10
    usecase "UC12: Đánh giá đơn (1-5 sao & ảnh)" as UC12
    usecase "UC13: Xem lịch sử đơn hàng" as UC13
    usecase "UC14: Đặt lại đơn này (Reorder)" as UC14
    usecase "UC15: Hủy đơn trước khi quán nhận" as UC15
}

KH --> UC01
KH --> UC02
KH --> UC04
KH --> UC06
KH --> UC09
KH --> UC10
KH --> UC13
KH --> UC15

UC04 ..> UC05 : <<include>>
UC09 ..> UC08 : <<include>>
UC07 ..> UC09 : <<extend>>
UC15 ..> UC09 : <<extend>>
UC12 ..> UC10 : <<extend>>
UC14 ..> UC13 : <<extend>>

UC02 <--> OSM : <<Tìm kiếm & Geocoding>>
UC08 <--> LL : <<Báo giá theo km>>
UC09 <--> ZLP : <<Cổng thanh toán Sandbox>>
UC15 ..> ZLP : <<Hoàn tiền tự động khi PAID>>
FCM ..> UC10 : <<Thông báo tiến trình>>
@enduml