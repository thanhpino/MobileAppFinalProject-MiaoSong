@startuml MiaoSong_QuanAn_Bep
title Phân hệ 2: Vận hành Quán ăn & Màn hình Bếp KDS (Merchant & Kitchen)
left to right direction

skinparam defaultFontName "Arial"
skinparam defaultFontSize 12
skinparam roundcorner 10
skinparam shadowing false
skinparam packageStyle rectangle

skinparam actor {
    BorderColor #8A57E8
    BackgroundColor #F3EDF7
    FontColor #212121
    FontSize 12
}

skinparam usecase {
    BorderColor #E65100
    BackgroundColor #FFF8E1
    FontColor #212121
    FontSize 12
    ArrowColor #37474F
}

skinparam rectangle {
    BorderColor #9E9E9E
    BackgroundColor #FAFAFA
    FontColor #212121
    FontSize 13
}

skinparam package {
    BorderColor #BDBDBD
    BackgroundColor #F5F5F5
    FontColor #37474F
    FontSize 12
}

skinparam arrow {
    Color #37474F
    FontColor #455A64
    FontSize 11
}


actor "Quán ăn / Nhân viên Bếp\n(MERCHANT)" as Q

actor "FCM\n<<Push & Chuông>>" as FCM <<System>>
actor "ZaloPay Sandbox\n<<Hoàn tiền>>" as ZLP <<System>>
actor "Lalamove API\n<<Giao vận>>" as LL <<System>>

rectangle "Phân hệ Quán ăn & Bếp (Merchant & Kitchen KDS)" {
    usecase "UC20: Đăng nhập tài khoản Quán" as UC20
    usecase "UC21: Quản lý danh mục món" as UC21
    usecase "UC22: Quản lý món & nhóm tùy chọn" as UC22
    usecase "UC23: Bật/tắt món hoặc option hết hàng" as UC23
    usecase "UC24: Quản lý mã giảm giá (Voucher)" as UC24
    usecase "UC25: Nhận đơn mới (Chuông báo)" as UC25
    usecase "UC26: Xác nhận đơn hàng" as UC26
    usecase "UC27: Từ chối đơn & Hoàn tiền tự động" as UC27
    usecase "UC28: Vận hành màn hình bếp (KDS)" as UC28
    usecase "UC29: Đánh dấu đã đóng gói" as UC29
    usecase "UC30: Gọi Shipper Lalamove" as UC30
    usecase "UC31: Theo dõi giao hàng & Cảnh báo trễ" as UC31
    usecase "UC32: Đổi trạng thái (Mở / Bận / Đóng)" as UC32
    usecase "UC33: Cài đặt lịch hoạt động thường ngày" as UC33
    usecase "UC34: Xem đánh giá khách hàng" as UC34
    usecase "UC35: Thống kê doanh thu ngày" as UC35
    usecase "UC36: Nhắn tin in-app với Khách hàng" as UC36
}

Q --> UC20
Q --> UC21
Q --> UC22
Q --> UC23
Q --> UC24
Q --> UC25
Q --> UC28
Q --> UC30
Q --> UC31
Q --> UC32
Q --> UC33
Q --> UC34
Q --> UC35
Q --> UC36

UC26 ..> UC25 : <<extend>>
UC27 ..> UC25 : <<extend>>
UC27 ..> UC23 : <<include>>
UC28 ..> UC29 : <<include>>
UC30 ..> UC29 : <<include>>

FCM ..> UC25 : <<Kích hoạt chuông reo lặp>>
UC27 --> ZLP : <<Tự động gọi /v2/refund>>
UC30 --> LL : <<Tạo đơn giao hàng xe máy>>
@enduml