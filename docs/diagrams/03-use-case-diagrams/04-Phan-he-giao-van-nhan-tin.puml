@startuml MiaoSong_GiaoVan_NhanTin
title Phân hệ 3: Điều phối Giao vận & Giao tiếp Realtime (Dispatch & Realtime Chat)
left to right direction

skinparam defaultFontName "Arial"
skinparam defaultFontSize 12
skinparam roundcorner 10
skinparam shadowing false
skinparam packageStyle rectangle

skinparam actor {
    BorderColor #8A57E8
    BackgroundColor #F3EDF7
    FontColor #212121
    FontSize 12
}

skinparam usecase {
    BorderColor #E65100
    BackgroundColor #FFF8E1
    FontColor #212121
    FontSize 12
    ArrowColor #37474F
}

skinparam rectangle {
    BorderColor #9E9E9E
    BackgroundColor #FAFAFA
    FontColor #212121
    FontSize 13
}

skinparam package {
    BorderColor #BDBDBD
    BackgroundColor #F5F5F5
    FontColor #37474F
    FontSize 12
}

skinparam arrow {
    Color #37474F
    FontColor #455A64
    FontSize 11
}


actor "Khách hàng\n(CUSTOMER)" as KH
actor "Quán ăn\n(MERCHANT)" as Q

actor "Lalamove API v3\n<<Giao vận>>" as LL <<System>>
actor "FCM\n<<Push Notification>>" as FCM <<System>>

rectangle "Phân hệ Điều phối Giao vận & Nhắn tin Realtime" {
    usecase "UC08: Xem báo giá ship theo km" as UC08
    usecase "UC10: Theo dõi đơn & Thẻ tài xế" as UC10
    usecase "UC16: Nhắn tin in-app (Khách)" as UC16
    usecase "UC30: Gọi Shipper Lalamove" as UC30
    usecase "UC31: Theo dõi giao hàng & Cảnh báo trễ" as UC31
    usecase "UC36: Nhắn tin in-app (Quán)" as UC36
    usecase "UC40: Đồng bộ tài xế qua Webhook" as UC40
    usecase "UC44: Gửi Push Notification trạng thái" as UC44
}

KH --> UC08
KH --> UC10
KH --> UC16

Q --> UC30
Q --> UC31
Q --> UC36

UC08 <--> LL : <<Báo giá cước km>>
UC30 --> LL : <<Tạo đơn giao hàng>>
LL --> UC40 : <<POST webhook sự kiện>>

UC40 ..> UC10 : <<include: hiện tên, SĐT, biển số>>
UC40 ..> UC31 : <<include: cập nhật tiến trình>>
UC40 ..> UC44 : <<include: kích hoạt push>>
UC44 --> FCM : <<Bắn push thông báo>>

UC16 <..> UC36 : <<Kênh chat Firestore Realtime>>
@enduml