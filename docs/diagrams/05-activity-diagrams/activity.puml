@startuml MiaoSong_Activity_Diagrams
title Sơ đồ Hoạt động Toàn hệ thống MiaoSong (D2C F&B Platform)

skinparam shadowing false
skinparam defaultFontName "Arial"
skinparam defaultFontSize 12

skinparam activity {
    BackgroundColor #FFF8E1
    BorderColor #F57F17
    ArrowColor #37474F
    BarColor #E65100
    StartColor #2E7D32
    EndColor #C62828
}

' ========================================================
' LUỒNG 1: ĐẶT HÀNG & THANH TOÁN
' ========================================================
partition "Luồng 1: Đặt hàng, Báo giá Ship & Thanh toán" {
    (*) --> "Khách duyệt Menu & chọn món"
    --> "Mở Bottom Sheet tùy chọn"
    --> "Chọn Size (bắt buộc) & Topping (tùy chọn)"
    --> "Nhập ghi chú món"
    --> "Tạo CartLineKey = sha1(...)"
    if "Trùng CartLineKey đã có?" then
        -->[Có] "Cộng dồn số lượng vào dòng cũ"
    else
        -->[Không] "Thêm dòng mới vào giỏ hàng Room"
    endif
    --> "Mở màn hình Checkout"
    --> "Chọn địa chỉ nhận hàng (OpenStreetMap / Nominatim)"
    --> "Gọi Lalamove API tính cước theo km"
    if "Khoảng cách <= maxDistanceKm?" then
        -->[Không] "Báo lỗi ngoài phạm vi phục vụ"
        --> "Chọn lại địa chỉ"
    else
        -->[Hợp lệ] "Hiển thị phí giao hàng & khoảng cách"
    endif
    if "Khách nhập mã Voucher?" then
        -->[Có] "Server thẩm định điều kiện Voucher"
        if "Thỏa mãn minOrder & hạn dùng?" then
            -->[Có] "Áp dụng giảm giá (không trừ vào phí ship)"
        else
            -->[Không] "Thông báo lý do từ chối Voucher"
        endif
    else
        -->[Không] "Bỏ qua khuyến mãi"
    endif
    --> "Bấm 'Đặt đơn' kèm idempotencyKey"
    --> "Server kiểm tra lại giá, tồn kho & giờ mở cửa"
    if "Hợp lệ?" then
        -->[Có] if "Phương thức thanh toán?" then
            -->[COD] "Tạo đơn: status = PLACED"
            --> "Xóa giỏ hàng & chuyển màn Theo dõi đơn"
            --> "FCM phát chuông tới thiết bị Quán"
            --> (*)
        else
            -->[ZaloPay Sandbox] "Tạo đơn: status = PENDING_PAYMENT (giữ voucher)"
            --> "Mở Chrome Custom Tabs / ZaloPay App"
            if "Khách thanh toán thành công?" then
                -->[Có] "ZaloPay gửi Callback xác nhận server-to-server"
                --> "Server verify MAC key2 (HMAC-SHA256)"
                --> "Chuyển trạng thái đơn: status = PLACED"
                --> "Xóa giỏ hàng & chuyển màn Theo dõi đơn"
                --> "FCM phát chuông tới thiết bị Quán"
                --> (*)
            else
                -->[Không / Hủy] "Đơn giữ PENDING_PAYMENT (cho phép trả lại trong 15p)"
                --> (*)
            endif
        endif
    else
        -->[Không] "Báo lỗi đổi giá hoặc hết món"
        --> "Quay lại Giỏ hàng"
    endif
}

' ========================================================
' LUỒNG 2: VẬN HÀNH BẾP & GỌI SHIPPER
' ========================================================
partition "Luồng 2: Tiếp nhận đơn, Vận hành Bếp & Gọi Shipper Lalamove" {
    (*) --> "Nhận chuông báo đơn mới (PLACED)"
    --> "Quán kiểm tra món & ghi chú đặc biệt"
    if "Quán quyết định?" then
        -->[Từ chối đơn] "Chọn lý do (Hết nguyên liệu / Quá tải)"
        --> "Cập nhật status = REJECTED & hoàn voucher"
        if "Đơn đã thanh toán ZaloPay?" then
            -->[Có] "Tự động gọi ZaloPay Refund API"
            --> "Cập nhật refundStatus = REFUNDED"
        else
            -->[Không] "Không cần hoàn tiền"
        endif
        --> "Gửi Push thông báo lý do cho Khách"
        --> (*)
    else
        -->[Xác nhận đơn] "Cập nhật status = CONFIRMED"
        --> "Push thông báo: Quán đang chuẩn bị món"
        --> "Vé xuất hiện trên Màn hình Bếp (KDS)"
        --> "Nổi bật cảnh báo dị ứng & ghi chú"
        --> "Đầu bếp hoàn thành chế biến"
        --> "Bấm 'Đã đóng gói': status = READY"
        --> "Chủ quán bấm 'Gọi Shipper'"
        if "Quote Lalamove còn hạn?" then
            -->[Hết hạn] "Lấy quote mới (Quán chịu chênh lệch)"
        else
            -->[Còn hạn] "Sử dụng quote hiện tại"
        endif
        --> "Gọi Lalamove API tạo chuyến"
        --> "status = FINDING_DRIVER"
        --> "Lalamove gán tài xế & bắn Webhook DRIVER_ASSIGNED"
        --> "Server đồng bộ Tên, SĐT, Biển số xe"
        --> "Realtime cập nhật thẻ tài xế trên app Khách"
        --> "Push rung thông báo tài xế đang tới quán"
        --> "Tài xế nhận món (PICKED_UP) -> Đang giao (DELIVERING)"
        --> "Giao thành công (COMPLETED)"
        --> (*)
    endif
}

' ========================================================
' LUỒNG 3: HỦY ĐƠN / TỪ CHỐI ĐƠN & HOÀN TIỀN ZALOPAY TỰ ĐỘNG
' ========================================================
partition "Luồng 3: Hủy đơn / Từ chối đơn & Hoàn tiền ZaloPay tự động" {
    (*) --> "Khách bấm Hủy đơn (PENDING_PAYMENT/PLACED) hoặc Quán bấm Từ chối (PLACED/CONFIRMED)"
    --> "Mở Firestore Transaction & kiểm tra OrderStateMachine"
    if "Đơn có áp dụng mã Voucher?" then
        -->[Có] "Hoàn trả lượt dùng Voucher (usedCount - 1)"
    else
        -->[Không] "Giữ nguyên"
    endif
    if "Đơn đã thanh toán ZaloPay (PAID)?" then
        -->[Có] "Cập nhật status = CANCELLED/REJECTED & refundStatus = PENDING"
        --> "Gọi POST /v2/refund ZaloPay Sandbox (HMAC-SHA256 key1)"
        if "return_code in [1, 3]?" then
            -->[Thành công] "Cập nhật refundStatus = REFUNDED"
            --> "Trigger onOrderUpdated gửi Push xác nhận hoàn tiền"
            --> (*)
        else
            -->[Thất bại] "Cập nhật refundStatus = REFUND_FAILED"
            --> "Gửi cảnh báo khẩn LATE_ALERT cho cả Khách & Quán"
            --> (*)
        endif
    else
        -->[Không (COD / UNPAID)] "Cập nhật status = CANCELLED/REJECTED & refundStatus = NONE"
        --> "Trigger onOrderUpdated gửi Push thông báo cho Khách & Quán"
        --> (*)
    endif
}

' ========================================================
' LUỒNG 4: TÁC VỤ NỀN TỰ ĐỘNG HÓA
' ========================================================
partition "Luồng 4: Tác vụ Nền Tự động hóa (Cloud Scheduler)" {
    (*) --> "Cloud Scheduler kích hoạt mỗi 5 phút"
    --> "Quét orders PENDING_PAYMENT quá hạn 15 phút"
    if "Có đơn quá hạn?" then
        -->[Có] "Transaction: status = CANCELLED & Hoàn voucher"
    else
        -->[Không] "Bỏ qua"
    endif
    --> "Quét orders đang giao vượt quá ETA + 15 phút"
    if "Có đơn giao trễ chưa cảnh báo?" then
        -->[Có] "Gắn cờ lateFlag = true & Bắn cảnh báo đỏ tới Quán"
    else
        -->[Không] "Bỏ qua"
    endif
    --> (*)
}

' ========================================================
' LUỒNG 5: ĐÁNH GIÁ & ĐẶT LẠI ĐƠN (REORDER)
' ========================================================
partition "Luồng 5: Đánh giá & Đặt lại đơn cũ (Reorder)" {
    (*) --> "Đơn hàng chuyển sang COMPLETED"
    --> "Hiển thị Bottom Sheet đánh giá chất lượng"
    if "Khách đánh giá ngay?" then
        -->[Có] "Chọn 1-5 sao, chọn tag & viết nhận xét"
        --> "Lưu review & cập nhật rating trung bình quán"
        --> "Lưu vào Lịch sử đơn hàng"
    else
        -->[Để sau] "Lưu vào Lịch sử đơn hàng"
    endif
    --> "Khách mở lại đơn cũ & bấm 'Đặt lại đơn này'"
    --> "Hệ thống lấy thực đơn hiện tại của Quán"
    --> "Đối chiếu từng món, size, topping cũ"
    if "Món cũ còn bán không?" then
        -->[Hết món] "Bỏ qua món đó & thông báo cho khách"
    else
        -->[Còn bán] if "Giá có đổi không?" then
            -->[Đổi giá] "Dùng đơn giá mới & hiện nhãn 'Giá cập nhật'"
        else
            -->[Giữ nguyên] "Giữ nguyên đơn giá cũ"
        endif
        --> "Nạp lại dòng món vào giỏ hàng Room"
    endif
    --> "Mở màn hình Giỏ hàng với danh sách món hợp lệ"
    --> (*)
}

@enduml
